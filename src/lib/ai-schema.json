{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "title",
    "summary",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "title": "Task",
            "required": [
              "id",
              "type",
              "text",
              "done"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "task"
              },
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "text": {
                "type": "string"
              },
              "done": {
                "type": "boolean"
              },
              "deadline": {
                "type": "string",
                "format": "date-time"
              },
              "priority": {
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              }
            }
          },
          {
            "title": "Idea",
            "required": [
              "id",
              "type",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "idea"
              },
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "text": {
                "type": "string"
              }
            }
          },
          {
            "title": "ShoppingItem",
            "required": [
              "id",
              "type",
              "name",
              "bought"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "shopping_item"
              },
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "name": {
                "type": "string"
              },
              "quantity": {
                "type": "string"
              },
              "bought": {
                "type": "boolean"
              }
            }
          },
          {
            "title": "WishlistItem",
            "required": [
              "id",
              "type",
              "title",
              "rarity",
              "isGiftIdea"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "wishlist_item"
              },
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "title": {
                "type": "string"
              },
              "rarity": {
                "enum": [
                  "common",
                  "rare",
                  "epic",
                  "legendary"
                ]
              },
              "isGiftIdea": {
                "type": "boolean"
              },
              "price": {
                "type": "string"
              },
              "link": {
                "type": "string"
              }
            }
          },
          {
            "title": "AdditionalQuestion",
            "required": [
              "id",
              "type",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "additional_question"
              },
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "text": {
                "type": "string"
              }
            }
          }
        ]
      }
    }
  }
}